# ==============================================================================
# Solaira — environment template
# ==============================================================================
# Copy to `.env.local` and fill in the real values:
#
#     cp .env.example .env.local          # Linux/macOS
#     copy .env.example .env.local        # Windows
#
# ONE file serves BOTH apps:
#   - Next.js auto-loads `.env.local` from the project root
#   - backend/main.py loads the same file explicitly (load_dotenv root/.env.local)
#
# Never commit `.env.local`. It is gitignored.
# Variables marked REQUIRED have no safe default and the app will not work without
# them. Everything else has the default shown in the comment.
# ==============================================================================


# ─── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Never prefix with NEXT_PUBLIC_.
# Without it, /api/profile falls back to the anon key and RLS may reject writes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# ─── Service URLs ─────────────────────────────────────────────────────────────
# FastAPI main service (backend/main.py). Default: http://localhost:8001
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8001

# Quartz solar-forecast service (backend/models/quartz-solar-forecast).
# Used server-side by pages/api/solar-forecast.js. Default: http://localhost:8002
SOLAR_FORECAST_SERVICE_URL=http://localhost:8002


# ─── Backend: main service ────────────────────────────────────────────────────
# Chatbot (Cerebras). If unset, the API still boots but /api/chat reports
# "Agent not initialized".
CEREBRAS_API_KEY=

# Comma-separated failover chain, tried in order on rate limit.
# Default: llama3.1-8b
MODEL_NAMES=llama3.1-8b

# Default: 8001
PORT=8001

# Comma-separated allowed origins. Default: *
CORS_ORIGINS=*

# Battery defaults for the simulation service. Defaults: 13.5 / 50
BATTERY_CAPACITY_KWH=13.5
INITIAL_SOC_PERCENT=50

# Where historical CSVs live (relative to repo root). Default: backend/data
DATA_DIR=backend/data

# Default: INFO
LOG_LEVEL=INFO


# ─── App defaults & branding ─────────────────────────────────────────────────
# Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=info@solaira.tn
NEXT_PUBLIC_CONTACT_PHONE=(+216) 99-999-999

# Supported panel configurations. Default: 2,4,8,10,12,16
NEXT_PUBLIC_SUPPORTED_PANEL_COUNTS=2,4,8,10,12,16
# Default: 10
NEXT_PUBLIC_DEFAULT_PANELS=10
# Default: 13.5
NEXT_PUBLIC_DEFAULT_BATTERY_KWH=13.5

# Electricity tariffs used for savings estimates (currency/kWh).
# Defaults: 0.20 / 0.12
NEXT_PUBLIC_GRID_PRICE_KWH=0.20
NEXT_PUBLIC_EXPORT_PRICE_KWH=0.12


# ─── Quartz solar forecast (optional) ────────────────────────────────────────
# Default: True
QUARTZ_SOLAR_FORECAST_LOGGING=True
