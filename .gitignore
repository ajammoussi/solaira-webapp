# ─── Node ──────────────────────────────────────────────────────────────
node_modules/
.next/
.swc/
out/
build/
*.tsbuildinfo
next-env.d.ts

# ─── Environment (never commit real values) ────────────────────────────
.env
.env.local
.env.*.local

# ─── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
backend/tf_env/
backend/.venv/
backend/.venv-forecast/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml
coverage/

# ─── Runtime state (never commit) ──────────────────────────────────────
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# ─── Backend generated output ─────────────────────────────────────────
# monitoring_data/ is intentionally tracked: maintenance_config.yaml and the
# predictive-maintenance tests read those CSV fixtures, so ignoring the folder
# would hide real drift (and did hide a stray backend/backend/ copy).
results/

# ─── Tooling / editor ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ─── Backups ───────────────────────────────────────────────────────────
*.backup
